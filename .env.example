# DXN Orion - Environment Configuration
# Copy this file to .env and configure for your local or production environment.

# Server & Application
PORT=3000
NODE_ENV="development"
APP_URL="https://dxn-orion.com"

# Admin Authentication
ADMIN_EMAIL="shivam@dxn-orion.com"
ADMIN_PASSWORD="ChangeMeInProduction!2026"
JWT_SECRET="dxn_orion_secure_jwt_session_token_key_32charsmin"

# Google Cloud SQL (PostgreSQL 15)
# Connection through Cloud SQL Node.js Connector / Cloud SQL Auth Proxy:
DB_USER="dxn_db_user"
DB_PASS="CloudSqlSecurePassword123"
DB_NAME="dxn_orion_db"
INSTANCE_CONNECTION_NAME="your-gcp-project:asia-south1:dxn-orion-pg15"
DATABASE_URL="postgresql://dxn_db_user:CloudSqlSecurePassword123@127.0.0.1:5432/dxn_orion_db"

# Google Cloud Storage (Media & WebP Uploads)
GCS_BUCKET_NAME="dxn-orion-media-public"
GCS_PROJECT_ID="your-gcp-project-id"

# Tracking & Analytics
GA4_ID="G-DXNORION22D"
META_PIXEL_ID="7849102938471"
GOOGLE_ADS_ID="AW-984029182"
GSC_VERIFICATION="google-site-verification=dxn_orion_yamuna_exp_sec22d"

# Notifications (Optional)
ADMIN_NOTIFICATION_EMAIL="shivam@dxn-orion.com"
RESEND_API_KEY=""
WHATSAPP_WEBHOOK_URL=""
